<Window x:Class="Entertainment.ComputerLog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Entertainment"
        mc:Ignorable="d"
        Title="ComputerLog" Height="700" Width="900">
    <Window.Resources>
        <local:SoldInfoVisibilityConverter x:Key="SoldInfoVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Back, Profile and Sign Out -->
        <DockPanel Grid.Row="0" Margin="10">
            <Button x:Name="ProfileButton" Content="Profile" Click="ProfileButton_Click" 
                    DockPanel.Dock="Left" Padding="10,5" Margin="0,0,10,0"/>
            <Button x:Name="SignOutButton" Content="Sign Out" Click="SignOut_Click" 
                    DockPanel.Dock="Right" Padding="10,5"/>
        </DockPanel>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <!-- Log In Section -->
            <TextBlock HorizontalAlignment="Left" Margin="30,20,0,0" TextWrapping="Wrap" Text="LOG IN NEW ITEM" FontWeight="Bold" FontSize="14" VerticalAlignment="Top"/>
            
            <!-- UPC Search -->
            <TextBlock HorizontalAlignment="Left" Margin="30,55,0,0" TextWrapping="Wrap" Text="Search UPC:*" VerticalAlignment="Top"/>
            <TextBox x:Name="UPCSearchBox" HorizontalAlignment="Left" Margin="150,52,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Height="24" TextChanged="UPCSearchBox_TextChanged"/>
            
            <!-- UPC Results List with Headers -->
            <TextBlock HorizontalAlignment="Left" Margin="30,85,0,0" TextWrapping="Wrap" Text="Matching UPCs:" VerticalAlignment="Top"/>
            <Grid HorizontalAlignment="Left" Margin="150,82,0,0" VerticalAlignment="Top" Width="320">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <!-- Header row -->
                <Border Grid.Row="0" Grid.Column="0" Background="#E0E0E0" Padding="5,3">
                    <TextBlock Text="UPC" FontWeight="Bold"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#E0E0E0" Padding="5,3" BorderBrush="Gray" BorderThickness="1,0,0,0">
                    <TextBlock Text="Make" FontWeight="Bold"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="#E0E0E0" Padding="5,3" BorderBrush="Gray" BorderThickness="1,0,0,0">
                    <TextBlock Text="Type" FontWeight="Bold"/>
                </Border>
                <!-- ListBox in row 1 -->
                <ListBox x:Name="UPCListBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                         SelectionChanged="UPCListBox_SelectionChanged" 
                         Height="80" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding UPC}" Padding="5,2"/>
                                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1,0,0,0">
                                    <TextBlock Text="{Binding Make}" Padding="5,2"/>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1,0,0,0">
                                    <TextBlock Text="{Binding Type}" Padding="5,2"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            
            <!-- Add New UPC Button -->
            <Button x:Name="AddNewUPCButton" Content="+ Add New UPC" HorizontalAlignment="Left" Margin="340,82,0,0" VerticalAlignment="Top" Width="100" Height="24" Click="AddNewUPCButton_Click"/>
            
            <!-- Selected UPC Display -->
            <TextBlock HorizontalAlignment="Left" Margin="360,55,0,0" TextWrapping="Wrap" Text="Selected UPC:" VerticalAlignment="Top"/>
            <TextBlock x:Name="SelectedUPC" HorizontalAlignment="Left" Margin="450,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" FontWeight="Bold"/>
            <TextBlock x:Name="SelectedUPCInfo" HorizontalAlignment="Left" Margin="450,75,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="200" Foreground="Gray" FontSize="11"/>
            
            <!-- New UPC Form (initially hidden) -->
            <Border x:Name="NewUPCPanel" BorderBrush="Gray" BorderThickness="1" Margin="30,115,30,0" Padding="10" VerticalAlignment="Top" Height="55" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="New UPC:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="NewUPCBox" Width="120" Height="24" Margin="0,0,20,0"/>
                    <TextBlock Text="Make:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="NewUPCMakeBox" Width="100" Height="24" Margin="0,0,20,0"/>
                    <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="NewUPCTypeBox" Width="100" Height="24" Margin="0,0,20,0"/>
                    <Button x:Name="SaveNewUPCButton" Content="Save UPC" Width="80" Height="24" Click="SaveNewUPCButton_Click"/>
                    <Button x:Name="CancelNewUPCButton" Content="Cancel" Width="60" Height="24" Margin="10,0,0,0" Click="CancelNewUPCButton_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Serial Number Input -->
            <TextBlock HorizontalAlignment="Left" Margin="30,175,0,0" TextWrapping="Wrap" Text="Serial Number:*" VerticalAlignment="Top"/>
            <TextBox x:Name="LogInSerialNumber" HorizontalAlignment="Left" Margin="150,172,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Height="24"/>
            
            <!-- Make/Type and Status Dropdowns -->
            <!-- REMOVED: Make/Type dropdown - Type is now inherited from UPC -->
            
            <TextBlock HorizontalAlignment="Left" Margin="340,175,0,0" TextWrapping="Wrap" Text="Status:" VerticalAlignment="Top"/>
            <ComboBox x:Name="StatusComboBox" HorizontalAlignment="Left" Margin="340,172,0,0" VerticalAlignment="Top" Width="120" Height="24"/>
            
            <Button x:Name="AddSerialButton" Content="Add Serial" HorizontalAlignment="Left" Margin="150,205,0,0" VerticalAlignment="Top" Width="90" Height="28" Click="AddSerialButton_Click"/>
            
            <!-- Serial Numbers List -->
            <TextBlock HorizontalAlignment="Left" Margin="30,250,0,0" TextWrapping="Wrap" Text="Serial Numbers to Log In:" VerticalAlignment="Top"/>
            <ListBox x:Name="SerialNumbersListBox" HorizontalAlignment="Left" Margin="150,247,0,0" VerticalAlignment="Top" Width="280" Height="100"/>
            
            <Button x:Name="RemoveSerialButton" Content="Remove" HorizontalAlignment="Left" Margin="440,260,0,0" VerticalAlignment="Top" Width="80" Height="24" Click="RemoveSerialButton_Click"/>
            
            <!-- New Section: Selected Serial Status Update -->
            <TextBlock HorizontalAlignment="Left" Margin="30,360,0,0" TextWrapping="Wrap" Text="UPDATE SERIAL STATUS" FontWeight="Bold" FontSize="14" VerticalAlignment="Top"/>
            
            <!-- Selected Serial Display -->
            <TextBlock HorizontalAlignment="Left" Margin="30,395,0,0" TextWrapping="Wrap" Text="Selected Serial:" VerticalAlignment="Top"/>
            <TextBlock x:Name="SelectedSerialDisplay" HorizontalAlignment="Left" Margin="150,395,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="280" FontWeight="Bold"/>
            
            <!-- Status Dropdown and Online Pick Checkbox - Row 1 -->
            <TextBlock HorizontalAlignment="Left" Margin="30,430,0,0" TextWrapping="Wrap" Text="New Status:" VerticalAlignment="Top"/>
            <ComboBox x:Name="UpdateStatusComboBox" HorizontalAlignment="Left" Margin="150,427,0,0" VerticalAlignment="Top" Width="150" Height="24"/>
            
            <!-- Online Pick Checkbox - clearly visible next to status dropdown -->
            <CheckBox x:Name="OnlinePickCheckBox" Content="Online Pick (OGP)" HorizontalAlignment="Left" Margin="310,427,0,0" VerticalAlignment="Top" Height="24"/>
            
            <!-- Update Status Button -->
            <Button x:Name="UpdateStatusButton" Content="Update Status" HorizontalAlignment="Left" Margin="500,425,0,0" VerticalAlignment="Top" Width="120" Height="28" Click="UpdateStatusButton_Click"/>
            
            <!-- Divider -->
            <Rectangle HorizontalAlignment="Left" Height="2" Margin="30,470,0,0" VerticalAlignment="Top" Width="820" Fill="Gray"/>
            
            <!-- Search Section -->
            <TextBlock HorizontalAlignment="Left" Margin="30,485,0,0" TextWrapping="Wrap" Text="SEARCH / LOG OUT" FontWeight="Bold" FontSize="14" VerticalAlignment="Top"/>
            
            <TextBox x:Name="SerialGetInput" HorizontalAlignment="Left" Margin="150,485,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="24"/>
            <TextBlock HorizontalAlignment="Left" Margin="30,488,0,0" TextWrapping="Wrap" Text="Serial #:" VerticalAlignment="Top"/>
            
            <TextBox x:Name="UPCSearchInput" HorizontalAlignment="Left" Margin="360,485,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="24"/>
            <TextBlock HorizontalAlignment="Left" Margin="310,488,0,0" TextWrapping="Wrap" Text="UPC:" VerticalAlignment="Top"/>
            
            <Button x:Name="Search" Content="Search" HorizontalAlignment="Left" Margin="500,483,0,0" VerticalAlignment="Top" Width="100" Height="28" Click="Search_Click"/>
            
            <TextBlock x:Name="UPCBox" HorizontalAlignment="Left" Margin="30,460,0,0" TextWrapping="Wrap" Text="UPC:" VerticalAlignment="Top" Height="18"/>
            <TextBlock x:Name="SerialTextBox" HorizontalAlignment="Left" Margin="30,485,0,0" TextWrapping="Wrap" Text="Serial #:" VerticalAlignment="Top"/>
            
            <ListBox x:Name="ResultsListBox" SelectionChanged="ResultsListBox_SelectionChanged" Margin="30,520,30,100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Serial Number:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SerialNumber}"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="UPC:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UPC[0]}"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Make:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Make}"/>
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Type:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Type}"/>
                                
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Status}"/>
                                
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Online Pick:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OnlinePick}"/>
                                
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Created By:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CreatedBy}"/>
                                
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Created At:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}"/>
                                
                                <TextBlock Grid.Row="8" Grid.Column="2" Text="Sold By:" FontWeight="Bold" 
                                           Visibility="{Binding SoldAt, Converter={StaticResource SoldInfoVisibilityConverter}}"/>
                                <TextBlock Grid.Row="8" Grid.Column="3" Text="{Binding SoldBy}"
                                           Visibility="{Binding SoldAt, Converter={StaticResource SoldInfoVisibilityConverter}}"/>
                                
                                <TextBlock Grid.Row="9" Grid.Column="2" Text="Sold At:" FontWeight="Bold"
                                           Visibility="{Binding SoldAt, Converter={StaticResource SoldInfoVisibilityConverter}}"/>
                                <TextBlock Grid.Row="9" Grid.Column="3" Text="{Binding SoldAt, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}"
                                           Visibility="{Binding SoldAt, Converter={StaticResource SoldInfoVisibilityConverter}}"/>
                                
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <!-- Log Out Section -->
            <TextBlock HorizontalAlignment="Left" Margin="30,560,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="18"/>
            
            <ComboBox x:Name="LogOutReason" HorizontalAlignment="Left" Margin="150,640,0,0" VerticalAlignment="Top" Width="150"/>
            
            <TextBlock HorizontalAlignment="Left" Margin="30,643,0,0" TextWrapping="Wrap" Text="Log Out Reason:" VerticalAlignment="Top"/>
            
            <Button x:Name="LogOutSerial" Content="Log Out Serial #" HorizontalAlignment="Left" Margin="310,638,0,0" VerticalAlignment="Top" Width="130" Height="28" Click="LogOutSerial_Click"/>
            
            <CheckBox x:Name="OGPCheck" Content="This is an online pick " HorizontalAlignment="Left" Margin="500,643,0,0" VerticalAlignment="Top" Height="24" Width="210"/>

        </Grid>
    </Grid>
</Window>
