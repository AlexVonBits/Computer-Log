<Window x:Class="Entertainment.InventoryVerification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Entertainment"
        mc:Ignorable="d"
        Title="Inventory Verification" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <!-- Value Converters -->
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style x:Key="ConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Profile, Sign Out, and QR Slideshow -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="ProfileButton" Content="Profile" Click="ProfileButton_Click" 
                    DockPanel.Dock="Left" Padding="10,5" Margin="0,0,10,0"/>
            <Button x:Name="SignOutButton" Content="Sign Out" Click="SignOut_Click" 
                    DockPanel.Dock="Right" Padding="10,5"/>
            <TextBlock x:Name="UserDisplayText" FontSize="14" Foreground="#888" 
                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
            
            <!-- QR Code Slideshow Section -->
            <Border DockPanel.Dock="Right" Background="#252525" CornerRadius="6" 
                    Padding="15" Margin="20,0,0,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- QR Code Display -->
                    <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="10" HorizontalAlignment="Center">
                        <Image x:Name="SessionQRCode" Width="120" Height="120" 
                               VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- UPC Display -->
                    <TextBlock x:Name="SessionInfoText" Grid.Row="1" 
                               Foreground="#AAA" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    
                    <!-- Navigation Controls -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" 
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="PrevQRButton" Content="◀" 
                                Click="PrevQR_Click" Padding="8,4" Margin="0,0,5,0"
                                Background="#3C3C3C" Foreground="White" BorderBrush="#555"/>
                        <CheckBox x:Name="AutoAdvanceCheckBox" Content="Auto" 
                                  Foreground="#888" VerticalAlignment="Center" Margin="5,0"
                                  Checked="AutoAdvanceCheckBox_Changed" Unchecked="AutoAdvanceCheckBox_Changed"/>
                        <Button x:Name="NextQRButton" Content="▶" 
                                Click="NextQR_Click" Padding="8,4" Margin="5,0,0,0"
                                Background="#3C3C3C" Foreground="White" BorderBrush="#555"/>
                    </StackPanel>
                    
                    <!-- Counter -->
                    <TextBlock x:Name="QRCounterText" Grid.Row="2" 
                               Foreground="#666" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,30,0,0"/>
                </Grid>
            </Border>
        </DockPanel>
        
        <!-- Barcode Input Section -->
        <Border Grid.Row="1" Background="#252525" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Scanner Input -->
                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="Scan Barcode / Serial Number" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="BarcodeInputTextBox" Style="{StaticResource DarkTextBoxStyle}"
                             Width="400" HorizontalAlignment="Left"
                             KeyDown="BarcodeInputTextBox_KeyDown"/>
                </StackPanel>
                
                <!-- Cross-Reference Toggle -->
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox x:Name="CrossReferenceCheckBox" Content="Cross-Reference Mode" 
                              Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"
                              Checked="CrossReferenceCheckBox_Changed" Unchecked="CrossReferenceCheckBox_Changed"/>
                </StackPanel>
                
                <!-- Cross-Reference Fields (hidden by default) -->
                <StackPanel x:Name="CrossReferencePanel" Grid.Column="0" Grid.ColumnSpan="2" 
                            Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Serial Number" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="SerialNumberTextBox" Style="{StaticResource DarkTextBoxStyle}" Width="200"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="UPC Code" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="UPCTextBox" Style="{StaticResource DarkTextBoxStyle}" Width="200"/>
                    </StackPanel>
                    <Button Content="Search" Style="{StaticResource DarkButtonStyle}" 
                            VerticalAlignment="Bottom" Margin="10,0,0,0"
                            Click="SearchButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Item Display Section -->
        <Border Grid.Row="2" Background="#252525" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Matched Items" FontSize="16" FontWeight="SemiBold" 
                           Foreground="White" Margin="0,0,0,10"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsListBox">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2C2C2C" CornerRadius="6" Padding="15" Margin="0,0,0,10"
                                        BorderBrush="#444" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Serial & Status -->
                                        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="Serial: " Foreground="#888" FontSize="13"/>
                                            <TextBlock Text="{Binding SerialNumber}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource StatusBadgeStyle}"
                                                Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12"/>
                                        </Border>
                                        
                                        <!-- UPC -->
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="UPC: " Foreground="#888" FontSize="12"/>
                                            <TextBlock Text="{Binding UPCDisplay}" Foreground="#AAA" FontSize="12"/>
                                        </StackPanel>
                                        
                                        <!-- Make/Type -->
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding Make}" Foreground="#888" FontSize="12"/>
                                            <TextBlock Text=" - " Foreground="#666" FontSize="12"/>
                                            <TextBlock Text="{Binding Type}" Foreground="#AAA" FontSize="12"/>
                                        </StackPanel>
                                        
                                        <!-- Last Verified Info -->
                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Orientation="Horizontal" Margin="0,5,0,0"
                                                    Visibility="{Binding LastVerifiedAt, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="Last Verified: " Foreground="#666" FontSize="11"/>
                                            <TextBlock Text="{Binding LastVerifiedDisplay}" Foreground="#777" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- No Items Message -->
                <TextBlock x:Name="NoItemsMessage" Grid.Row="1" 
                           Text="Scan a barcode or enter serial number to find items"
                           Foreground="#666" FontSize="14" HorizontalAlignment="Center" 
                           VerticalAlignment="Center" Visibility="Visible"/>
            </Grid>
        </Border>
        
        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="#252525" CornerRadius="8" Padding="20" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="ConfirmButton" Content="Confirm Verified" 
                            Style="{StaticResource ConfirmButtonStyle}"
                            Click="ConfirmButton_Click" IsEnabled="False"/>
                    <Button x:Name="RFIDIssueButton" Content="RFID Issue" 
                            Style="{StaticResource WarningButtonStyle}"
                            Click="RFIDIssueButton_Click" IsEnabled="False"/>
                </StackPanel>
                
                <!-- Right Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="WorkOnItButton" Content="Work On It" 
                            Style="{StaticResource DarkButtonStyle}"
                            Click="WorkOnItButton_Click" IsEnabled="False"/>
                    <Button x:Name="SkipButton" Content="Skip (Add Note)" 
                            Style="{StaticResource DarkButtonStyle}"
                            Click="SkipButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#1A1A1A" CornerRadius="4" Padding="15,10" Margin="0,15,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#888" FontSize="12"/>
        </Border>
    </Grid>
</Window>
