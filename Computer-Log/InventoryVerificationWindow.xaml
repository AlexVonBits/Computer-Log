<Window x:Class="Entertainment.InventoryVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Inventory Verification" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0071CE">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Info Section -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Last Person Who Verified -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Last Person That Verified:" FontWeight="Bold" FontSize="14" 
                               Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="WhoVerifiedLastText" Text="N/A" FontSize="14" 
                               Foreground="#0071CE" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Date/Time Verified -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Date/Time Verified:" FontWeight="Bold" FontSize="14" 
                               Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="LastDateVerifiedText" Text="N/A" FontSize="14" 
                               Foreground="#0071CE" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Notes from Previous Verifications Header -->
                <StackPanel Grid.Row="2" Margin="0,10,0,5">
                    <TextBlock Text="Notes from Previous Verifications:" FontWeight="Bold" FontSize="14" 
                               Foreground="#333"/>
                </StackPanel>
                
                <!-- Notes DataGrid -->
                <DataGrid Grid.Row="3" x:Name="NotesDataGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="30"
                          MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UPC" Binding="{Binding UPC}" Width="150"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                        <DataGridTextColumn Header="User Initials" Binding="{Binding UserInitials}" Width="100"/>
                        <DataGridTextColumn Header="Date/Time" Binding="{Binding Timestamp, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
        <!-- Centered Start Button -->
        <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="StartVerificationButton" 
                    Content="Start Inventory Verification" 
                    Click="StartVerificationButton_Click"
                    FontSize="24" FontWeight="Bold"
                    Padding="40,20"
                    Background="White" 
                    Foreground="#0071CE"
                    BorderBrush="White"
                    BorderThickness="2"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
        
        <!-- Bottom filler for alignment -->
        <Border Grid.Row="2"/>
    </Grid>
</Window>