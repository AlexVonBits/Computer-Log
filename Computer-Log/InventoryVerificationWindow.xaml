<Window x:Class="Entertainment.InventoryVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Inventory Verification" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0071CE">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Info Section -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Top Row: Title and Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Last Person Who Verified -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Last Person That Verified:" FontWeight="Bold" FontSize="14" 
                                   Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="WhoVerifiedLastText" Text="N/A" FontSize="14" 
                                   Foreground="#0071CE" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="1" x:Name="CloseButton"
                            Content="Close"
                            Click="CloseButton_Click"
                            FontSize="14" FontWeight="Bold"
                            Padding="20,8"
                            Background="#6C757D" 
                            Foreground="White"
                            BorderBrush="#6C757D"
                            BorderThickness="2"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A6268"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#545B62"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                
                <!-- Date/Time Verified -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Last Date/Time Verified:" FontWeight="Bold" FontSize="14" 
                               Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="LastDateVerifiedText" Text="N/A" FontSize="14" 
                               Foreground="#0071CE" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Verification Summary from Last Session -->
                <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="6" Padding="15" Margin="0,10,0,15">
                    <StackPanel>
                        <TextBlock Text="Last Verification Session Summary:" FontWeight="Bold" FontSize="14" 
                                   Foreground="#333" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Issues Fixed:" FontSize="14" Foreground="#333" Margin="0,0,5,0"/>
                                <TextBlock x:Name="IssuesFixedCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#28A745"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Issues Not Fixed:" FontSize="14" Foreground="#333" Margin="0,0,5,0"/>
                                <TextBlock x:Name="IssuesNotFixedCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#DC3545"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="No Issues:" FontSize="14" Foreground="#333" Margin="0,0,5,0"/>
                                <TextBlock x:Name="NoIssuesCount" Text="0" FontSize="14" FontWeight="Bold" Foreground="#0071CE"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Purge Button (visible only for TeamLead/Admin) -->
                <Border Grid.Row="3" x:Name="PurgeButtonContainer" Margin="0,0,0,10" HorizontalAlignment="Left">
                    <Button x:Name="PurgeButton" 
                            Content="Purge Sold/Claimed" 
                            Click="PurgeButton_Click"
                            FontSize="14" FontWeight="Bold"
                            Padding="20,10"
                            Background="#DC3545" 
                            Foreground="White"
                            BorderBrush="#DC3545"
                            BorderThickness="2"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C82333"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#BD2130"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>
                
                <!-- Notes from Previous Verifications Header -->
                <StackPanel Grid.Row="4" Margin="0,10,0,5">
                    <TextBlock Text="Notes from Previous Verifications:" FontWeight="Bold" FontSize="14" 
                               Foreground="#333"/>
                </StackPanel>
                
                <!-- Notes DataGrid -->
                <DataGrid Grid.Row="5" x:Name="NotesDataGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="30"
                          MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UPC" Binding="{Binding UPC}" Width="150"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                        <DataGridTextColumn Header="User Initials" Binding="{Binding UserInitials}" Width="100"/>
                        <DataGridTextColumn Header="Date/Time" Binding="{Binding Timestamp, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
        <!-- Centered Start Button -->
        <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="StartVerificationButton" 
                    Content="Start Inventory Verification" 
                    Click="StartVerificationButton_Click"
                    FontSize="24" FontWeight="Bold"
                    Padding="40,20"
                    Background="White" 
                    Foreground="#0071CE"
                    BorderBrush="White"
                    BorderThickness="2"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
        
        <!-- Bottom filler for alignment -->
        <Border Grid.Row="2"/>
    </Grid>
</Window>