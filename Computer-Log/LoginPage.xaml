<Window x:Class="Entertainment.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Entertainment"
        mc:Ignorable="d"
        Title="LoginPage" Height="450" Width="800"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Logo - centered in upper area -->
        <Image Grid.Row="0" 
               Source="/Images/Walmart-Logo-2008-present.jpg" 
               Stretch="Uniform" 
               MaxHeight="150" 
               Margin="0,30,0,20"
               HorizontalAlignment="Center"/>
        
        <!-- Login Form Container - centered horizontally -->
        <Border Grid.Row="1" Grid.RowSpan="3" 
                Background="#252525" 
                CornerRadius="8" 
                Padding="30,25"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Username row -->
                <TextBlock x:Name="UserID" 
                           TextWrapping="Wrap" Text="User Name:" 
                           Foreground="White" FontSize="14"
                           Margin="0,0,0,8"
                           HorizontalAlignment="Left"/>
                <TextBox x:Name="UsernameBox" 
                         TextWrapping="Wrap" Width="250" 
                         Margin="0,0,0,20"
                         Padding="10,8"
                         FontSize="14"/>
                
                <!-- Password row -->
                <TextBlock x:Name="PasswordText" 
                           TextWrapping="Wrap" Text="Password:" 
                           Foreground="White" FontSize="14"
                           Margin="0,0,0,8"
                           HorizontalAlignment="Left"/>
                <PasswordBox x:Name="PasswordBox" 
                             Width="250" 
                             Margin="0,0,0,25"
                             Padding="10,8"
                             FontSize="14"/>
                
                <!-- Sign In button -->
                <Button x:Name="SignIn" 
                        Content="Sign In" Width="120" Height="35"
                        HorizontalAlignment="Center"
                        FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
