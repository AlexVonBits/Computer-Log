<Window x:Class="Entertainment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Entertainment"
        mc:Ignorable="d"
        Title="Computer Log" Height="800" Width="1000"
        Background="#F5F5F5">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0071CE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0071CE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005AAD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#005AAD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#004080"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#004080"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Secondary Button Style (e.g., Cancel, Sign Out) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0071CE"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Header Button Style (white with blue text for blue header) -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0071CE"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E6F0FA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E6F0FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCE0F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCE0F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Accent Button Style (Gold/Yellow) -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFC220"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FFC220"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5AD1C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E5AD1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CC9919"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CC9919"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0071CE"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <!-- Modern GroupBox Style -->
        <Style x:Key="ModernGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#0071CE" CornerRadius="5,5,0,0" Padding="12,8">
                                <ContentPresenter ContentSource="Header" 
                                                  TextBlock.FontWeight="SemiBold" 
                                                  TextBlock.FontSize="14"
                                                  TextBlock.Foreground="White"/>
                            </Border>
                            <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Background="White" CornerRadius="0,0,5,5">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- DataGrid Header Style -->
        <Style x:Key="BlueDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0071CE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#005AAD"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- DataGrid Alternating Row Style -->
        <Style x:Key="AlternatingRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F5F8FC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#0071CE"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F4FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Blue Header -->
        <Border Grid.Row="0" Background="#0071CE">
            <DockPanel Margin="10,0">
                <Button x:Name="ProfileButton" Content="Profile" Click="ProfileButton_Click" 
                        DockPanel.Dock="Left" Padding="10,5" Margin="0,0,10,0"
                        Style="{StaticResource HeaderButtonStyle}"/>
                <Button x:Name="SignOut" Content="Sign Out" Click="SignOut_Click" 
                        DockPanel.Dock="Right" Padding="10,5"
                        Style="{StaticResource HeaderButtonStyle}"/>
                <TextBlock x:Name="WelcomeText" FontSize="16" FontWeight="Bold" 
                           VerticalAlignment="Center" DockPanel.Dock="Left"
                           Foreground="White"/>
            </DockPanel>
        </Border>
        
        <!-- Start Inventory Verification Button - MOVED TO TOP -->
        <Button x:Name="StartInventoryVerificationButton" Grid.Row="1"
                Content="Inventory Verification" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Padding="30,15" 
                FontSize="16" 
                FontWeight="Bold"
                Style="{StaticResource ModernButtonStyle}"
                Click="StartInventoryVerificationButton_Click"
                Margin="0,10,0,20"
                Panel.ZIndex="100"/>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="20" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- TOP SECTION - UPC List -->
            <GroupBox Grid.Row="0" Header="UPC LIST" Margin="0,0,0,10" Style="{StaticResource ModernGroupBoxStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UPCSearchBox" Grid.Column="0" Height="32" 
                                 TextChanged="UPCSearchBox_TextChanged" 
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                        <TextBlock Grid.Column="0" Text="Search by last 4 digits or full UPC..." 
                                   IsHitTestVisible="False" Foreground="Gray" 
                                   VerticalAlignment="Center" Margin="7,0,0,0"
                                   Visibility="{Binding Text.Length, ElementName=UPCSearchBox, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <Button x:Name="AddNewUPCButton" Grid.Column="1" Content="+ Add New UPC" 
                                Margin="10,0,0,0" Click="AddNewUPCButton_Click" 
                                Style="{StaticResource ModernButtonStyle}"/>
                    </Grid>
                    
                    <!-- UPCs ListBox -->
                    <DataGrid x:Name="UPCListBox" Grid.Row="1" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="30"
                              AlternationCount="2"
                              AlternatingRowBackground="#F5F8FC"
                              ColumnHeaderStyle="{StaticResource BlueDataGridColumnHeaderStyle}"
                              SelectionChanged="UPCListBox_SelectionChanged"
                              MouseDoubleClick="UPCListBox_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource AlternatingRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsClearance}" Value="True">
                                        <Setter Property="Background" Value="#FFF8E1"/>
                                        <Setter Property="Foreground" Value="Goldenrod"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDeleted}" Value="True"/>
                                            <Condition Binding="{Binding IsClearance}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#FFCDD2"/>
                                        <Setter Property="Foreground" Value="DarkRed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ToggleClearanceMenuItem" Header="Toggle Clearance" Click="ToggleUPCClearance_Click"/>
                                <MenuItem x:Name="ToggleDeletedMenuItem" Header="Toggle Deleted" Click="ToggleUPCDeleted_Click"/>
                                <Separator/>
                                <MenuItem x:Name="DeleteUPCMenuItem" Header="Delete" Click="DeleteUPCContextMenu_Click"
                                          Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"/>
                                <MenuItem x:Name="LinkCrossRefsMenuItem" Header="Link Cross-References" Click="LinkCrossReferences_Click"/>
                                <Separator/>
                                <MenuItem x:Name="ViewQRCodeMenuItem" Header="View Barcode" Click="ViewQRCode_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UPC" Binding="{Binding UPC}" Width="150"/>
                            <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridTextColumn Header="On Hand" Binding="{Binding OnHand}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- New UPC Panel (initially hidden) -->
                    <Border x:Name="NewUPCPanel" Grid.Row="2" BorderBrush="Gray" BorderThickness="1" 
                            Padding="15" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="UPC:" VerticalAlignment="Center" Margin="0,0,10,5" FontWeight="Bold"/>
                            <TextBox x:Name="NewUPCBox" Grid.Row="0" Grid.Column="1" Height="32" Width="200" 
                                     HorizontalAlignment="Left" Margin="0,0,0,5" Style="{StaticResource ModernTextBoxStyle}"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Make:" VerticalAlignment="Center" Margin="0,0,10,5" FontWeight="Bold"/>
                            <ComboBox x:Name="NewUPCMakeBox" Grid.Row="1" Grid.Column="1" MinHeight="36" Width="200" 
                                      IsEditable="True" HorizontalAlignment="Left" Margin="0,0,0,5" Style="{StaticResource ModernComboBoxStyle}"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Device Type:" VerticalAlignment="Center" Margin="0,0,10,5" FontWeight="Bold"/>
                            <ComboBox x:Name="NewUPCTypeBox" Grid.Row="2" Grid.Column="1" MinHeight="36" Width="200" 
                                      IsEditable="True" HorizontalAlignment="Left" Margin="0,0,0,5" Style="{StaticResource ModernComboBoxStyle}"/>
                            
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="SaveNewUPCButton" Content="Save UPC" Width="80" Height="28" 
                                        Click="SaveNewUPCButton_Click" Margin="0,0,5,0"
                                        Style="{StaticResource AccentButtonStyle}"/>
                                <Button x:Name="CancelNewUPCButton" Content="Cancel" Width="70" Height="28" 
                                        Click="CancelNewUPCButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>
            
            <!-- BOTTOM SECTION - Serial Numbers -->
            <GroupBox Grid.Row="1" Header="SERIAL NUMBERS" Margin="0,10,0,0" Style="{StaticResource ModernGroupBoxStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Selected UPC Display -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Selected UPC: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SelectedUPC" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center" Foreground="Blue"/>
                        <TextBlock x:Name="SelectedUPCMake" Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </Grid>
                    
                    <!-- Search Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SerialSearchBox" Grid.Column="0" Height="32" 
                                 TextChanged="SerialSearchBox_TextChanged" 
                                 VerticalContentAlignment="Center" Padding="10,0"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                        <TextBlock Grid.Column="0" Text="Search serial numbers..." 
                                   IsHitTestVisible="False" Foreground="Gray" 
                                   VerticalAlignment="Center" Margin="7,0,0,0"
                                   Visibility="{Binding Text.Length, ElementName=SerialSearchBox, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <Button x:Name="AddNewSerialButton" Grid.Column="1" Content="+ Add New Serial" 
                                Margin="10,0,0,0" Click="AddNewSerialButton_Click" 
                                Style="{StaticResource ModernButtonStyle}"/>
                    </Grid>
                    
                    <!-- Serial Numbers DataGrid -->
                    <DataGrid x:Name="SerialNumbersGrid" Grid.Row="2" 
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="30"
                              AlternationCount="2"
                              AlternatingRowBackground="#F5F8FC"
                              ColumnHeaderStyle="{StaticResource BlueDataGridColumnHeaderStyle}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource AlternatingRowStyle}">
                                <Style.Triggers>
                                    <!-- Serial's own status colors - applies to entire row -->
                                    <DataTrigger Binding="{Binding Status}" Value="In Stock">
                                        <Setter Property="Foreground" Value="Blue"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Display">
                                        <Setter Property="Foreground" Value="Teal"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="In Claims">
                                        <Setter Property="Foreground" Value="Orange"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Deleted">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Clearance">
                                        <Setter Property="Foreground" Value="Goldenrod"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Sold">
                                        <Setter Property="Foreground" Value="#228B22"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Missing">
                                        <Setter Property="Foreground" Value="#9C27B0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Claimed Out">
                                        <Setter Property="Foreground" Value="#795548"/>
                                    </DataTrigger>
                                    <!-- Inherit color from parent UPC status (fallback when serial has no specific status) -->
                                    <DataTrigger Binding="{Binding UPCStatus}" Value="Clearance">
                                        <Setter Property="Foreground" Value="Goldenrod"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UPCStatus}" Value="Deleted">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="DeleteSerialMenuItem" Header="Delete" Click="DeleteSerialButton_Click"
                                          Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"/>
                                <Separator Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="180"/>
                            <DataGridTextColumn Header="Device Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="100"/>
                            <DataGridTextColumn Header="Created On" Binding="{Binding CreatedAt, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" Width="150"/>
                            <DataGridTextColumn Header="Sold By" Binding="{Binding SoldBy}" Width="100"/>
                            <DataGridTextColumn Header="Sold On" Binding="{Binding SoldAt, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- New Serial Panel (initially hidden) -->
                    <Border x:Name="NewSerialPanel" Grid.Row="3" BorderBrush="Gray" BorderThickness="1" 
                            Padding="15" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Serial Number:" VerticalAlignment="Center" Margin="0,0,10,5" FontWeight="Bold"/>
                            <TextBox x:Name="NewSerialBox" Grid.Row="0" Grid.Column="1" Height="32" Width="200" 
                                     HorizontalAlignment="Left" Margin="0,0,0,5" Style="{StaticResource ModernTextBoxStyle}"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="NewSerialStatusBox" Height="32" Width="150" Style="{StaticResource ModernComboBoxStyle}"/>
                                <TextBlock x:Name="NewSerialCreatedBy" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="Gray"/>
                                <Button x:Name="SaveNewSerialButton" Content="Save Serial" Width="80" Height="28" 
                                        Click="SaveNewSerialButton_Click" Margin="15,0,5,0"
                                        Style="{StaticResource AccentButtonStyle}"/>
                                <Button x:Name="CancelNewSerialButton" Content="Cancel" Width="70" Height="28" 
                                        Click="CancelNewSerialButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Change Status Panel (initially hidden) -->
                    <Border x:Name="ChangeStatusPanel" Grid.Row="3" BorderBrush="#0071CE" BorderThickness="1" 
                            Padding="15" Margin="0,10,0,0" Visibility="Collapsed" Background="#F0FFF0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Selected Serial:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedSerialText" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Blue" FontWeight="Bold"/>
                            <TextBlock Text="New Status:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                            <ComboBox x:Name="ChangeStatusComboBox" Height="32" Width="150" Margin="0,0,10,0" Style="{StaticResource ModernComboBoxStyle}"/>
                            <Button x:Name="UpdateStatusButton" Content="Update Status" Width="100" Height="28" 
                                    Click="UpdateStatusButton_Click" Margin="0,0,5,0"
                                    Style="{StaticResource ModernButtonStyle}"/>
                            <Button x:Name="CancelStatusButton" Content="Cancel" Width="70" Height="28" 
                                    Click="CancelStatusButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <CheckBox x:Name="OnlinePickBox" Content="This Is An Online Pick" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="White" Padding="10,8">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="13"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
