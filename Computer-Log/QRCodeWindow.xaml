<Window x:Class="Entertainment.QRCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QR Code" Height="350" Width="350" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="UPCLabel" Grid.Row="0" Text="UPC: " 
                   FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>
        
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" 
                Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="QRCodeImage" Width="200" Height="200"/>
        </Border>
        
        <Button Grid.Row="2" Content="Close" Width="80" Height="28" 
                Click="CloseButton_Click" Margin="0,15,0,0" 
                HorizontalAlignment="Center"
                Background="#0071CE" Foreground="White" BorderBrush="#0071CE"/>
    </Grid>
</Window>
