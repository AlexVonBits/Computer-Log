<Window x:Class="Entertainment.InventoryVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Inventory Verification" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="25,20" CornerRadius="8,8,0,0">
            <DockPanel>
                <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" 
                        DockPanel.Dock="Right" Padding="20,10" Background="#6C757D" Foreground="White" 
                        BorderThickness="0" Cursor="Hand"/>
                <StackPanel>
                    <TextBlock Text="INVENTORY VERIFICATION" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Track and manage inventory verification sessions" Foreground="White" Opacity="0.8" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Stats Panel -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1,0,1,0" Padding="25,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Last Verified By -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="LAST VERIFIED BY" FontWeight="Bold" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="WhoVerifiedLastText" Text="N/A" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,5,0,0"/>
                </StackPanel>
                
                <!-- Last Date Verified -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="LAST VERIFIED" FontWeight="Bold" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="LastDateVerifiedText" Text="N/A" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,5,0,0"/>
                </StackPanel>
                
                <!-- Issues Fixed Count -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ISSUES FIXED" FontWeight="Bold" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="IssuesFixedCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#28A745" Margin="0,5,0,0"/>
                </StackPanel>
                
                <!-- Issues Not Fixed Count -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="ISSUES NOT FIXED" FontWeight="Bold" Foreground="Gray" FontSize="12"/>
                    <TextBlock x:Name="IssuesNotFixedCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#DC3545" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Notes DataGrid -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1,0,1,1">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="VERIFICATION HISTORY" FontWeight="Bold" Foreground="Gray" FontSize="14" Margin="0,0,0,15"/>
                
                <DataGrid x:Name="NotesDataGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="UPC" Binding="{Binding UPC}" Width="150"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                        <DataGridTextColumn Header="User" Binding="{Binding UserInitials}" Width="80"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
        <!-- Bottom Actions -->
        <Border Grid.Row="3" Background="#F8F9FA" Padding="25,20" CornerRadius="0,0,8,8">
            <DockPanel>
                <!-- Purge Button (only visible for TeamLead/Admin) -->
                <Border x:Name="PurgeButtonContainer" Visibility="Collapsed" DockPanel.Dock="Left">
                    <Button x:Name="PurgeButton" Content="Purge Sold/Claimed Items" Click="PurgeButton_Click" 
                            Padding="20,10" Background="#DC3545" Foreground="White" 
                            BorderThickness="0" Cursor="Hand"/>
                </Border>
                
                <!-- Start Verification Button -->
                <Button x:Name="StartVerificationButton" Content="Start New Verification" Click="StartVerificationButton_Click" 
                        Padding="25,12" Background="#28A745" Foreground="White" 
                        BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right" FontWeight="Bold" FontSize="14"/>
                
                <!-- No Issues Count -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="No Issues: " Foreground="Gray"/>
                    <TextBlock x:Name="NoIssuesCount" Text="0" FontWeight="Bold" Foreground="#333"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
