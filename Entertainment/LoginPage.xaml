<Window x:Class="Entertainment.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Computer Log - Login" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
            <!-- Title -->
            <TextBlock x:Name="UserID" Text="COMPUTER LOGIN" FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#333"/>
            
            <!-- Username -->
            <TextBlock Text="USER ID" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox" Height="35" Padding="10,8" FontSize="14"/>
            
            <!-- Password -->
            <TextBlock x:Name="PasswordText" Text="PASSWORD" FontWeight="Bold" Margin="0,15,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Padding="10,8" FontSize="14"/>
            
            <!-- Sign In Button -->
            <Button x:Name="SignIn" Content="SIGN IN" Height="40" Margin="0,30,0,0" 
                    FontSize="16" FontWeight="Bold" Background="#0078D4" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
            
            <!-- Version -->
            <TextBlock Text="v1.3.4" HorizontalAlignment="Center" Margin="0,20,0,0" 
                       Foreground="Gray" FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
