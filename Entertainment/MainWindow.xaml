<Window x:Class="Entertainment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Entertainment"
        mc:Ignorable="d"
        Title="Computer Log" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="15,10">
            <DockPanel>
                <Button x:Name="ProfileButton" Content="Profile" Click="ProfileButton_Click" 
                        DockPanel.Dock="Left" Padding="15,8" Background="White" BorderThickness="0" 
                        Foreground="#333" FontWeight="Bold" Cursor="Hand"/>
                <Button x:Name="SignOut" Content="Sign Out" Click="SignOut_Click" 
                        DockPanel.Dock="Right" Padding="15,8" Background="#FF6B6B" BorderThickness="0" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                <TextBlock x:Name="WelcomeText" FontSize="18" FontWeight="Bold" 
                           Foreground="White" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Inventory Verification Button -->
            <Button x:Name="StartInventoryVerificationButton" Grid.Row="0" Content="Inventory Verification" 
                    Click="StartInventoryVerificationButton_Click" Padding="20,12" 
                    HorizontalAlignment="Left" Margin="0,0,0,15" Background="#28A745" 
                    Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
            
            <!-- Split View: UPC List (Top) and Serial Numbers (Bottom) -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- UPC List Section -->
                <GroupBox Grid.Row="0" Header="UPC LIST" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Search and Add -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UPCSearchBox" Grid.Column="0" Height="32" 
                                     TextChanged="UPCSearchBox_TextChanged" VerticalContentAlignment="Center" Padding="10,0"/>
                            <Button x:Name="AddNewUPCButton" Grid.Column="1" Content="+ Add New UPC" 
                                    Click="AddNewUPCButton_Click" Padding="15,8" Margin="10,0,0,0"
                                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        
                        <!-- UPC DataGrid -->
                        <DataGrid x:Name="UPCListBox" Grid.Row="1" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  SelectionChanged="UPCListBox_SelectionChanged"
                                  MouseDoubleClick="UPCListBox_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Toggle Clearance" Click="ToggleUPCClearance_Click"/>
                                    <MenuItem Header="Toggle Deleted" Click="ToggleUPCDeleted_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Edit UPC" Click="EditUPC_Click"/>
                                    <MenuItem x:Name="DeleteUPCMenuItem" Header="Delete" Click="DeleteUPCContextMenu_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="LinkCrossRefsMenuItem" Header="Link Cross-References" Click="LinkCrossReferences_Click"/>
                                    <MenuItem x:Name="ViewQRCodeMenuItem" Header="View QR Code" Click="ViewQRCode_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="UPC" Binding="{Binding UPC}" Width="180"/>
                                <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="150"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                                <DataGridTextColumn Header="On Hand" Binding="{Binding OnHand}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Clearance" Binding="{Binding IsClearance}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Deleted" Binding="{Binding IsDeleted}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <!-- New UPC Panel -->
                        <Border x:Name="NewUPCPanel" Grid.Row="2" BorderBrush="#0078D4" BorderThickness="2" 
                                Padding="20" Margin="0,15,0,0" Visibility="Collapsed" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="UPC:" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="NewUPCBox" Grid.Row="0" Grid.Column="1" Height="32" Width="250" 
                                         HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Make:" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="NewUPCMakeBox" Grid.Row="1" Grid.Column="1" Height="32" Width="250" 
                                          IsEditable="True" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Type:" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ComboBox x:Name="NewUPCTypeBox" Grid.Row="2" Grid.Column="1" Height="32" Width="250" 
                                          IsEditable="True" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SaveNewUPCButton" Content="Save UPC" Width="100" Height="32" 
                                            Click="SaveNewUPCButton_Click" Background="#28A745" Foreground="White" 
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                                    <Button x:Name="CancelNewUPCButton" Content="Cancel" Width="80" Height="32" 
                                            Click="CancelNewUPCButton_Click" Background="#6C757D" Foreground="White" 
                                            BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>
                
                <!-- Serial Numbers Section -->
                <GroupBox Grid.Row="1" Header="SERIAL NUMBERS" Margin="0,10,0,0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Selected UPC -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Selected UPC: " FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="SelectedUPC" FontWeight="Bold" FontSize="14" Foreground="#0078D4"/>
                            <TextBlock x:Name="SelectedUPCMake" FontSize="14" Foreground="Gray" Margin="10,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Search and Add -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SerialSearchBox" Grid.Column="0" Height="32" 
                                     TextChanged="SerialSearchBox_TextChanged" VerticalContentAlignment="Center" Padding="10,0"/>
                            <Button x:Name="AddNewSerialButton" Grid.Column="1" Content="+ Add New Serial" 
                                    Click="AddNewSerialButton_Click" Padding="15,8" Margin="10,0,0,0"
                                    Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        
                        <!-- Serial DataGrid -->
                        <DataGrid x:Name="SerialNumbersGrid" Grid.Row="2" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  SelectionChanged="SerialNumbersGrid_SelectionChanged">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit Serial" Click="EditSerial_Click"/>
                                    <MenuItem x:Name="DeleteSerialMenuItem" Header="Delete" Click="DeleteSerialButton_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Mark as Deleted" Click="MarkAsDeleted_Click"/>
                                    <MenuItem Header="Mark as Clearance" Click="MarkAsClearance_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="200"/>
                                <DataGridTextColumn Header="Device Type" Binding="{Binding Type}" Width="150"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="100"/>
                                <DataGridTextColumn Header="Created On" Binding="{Binding CreatedAt, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" Width="150"/>
                                <DataGridTextColumn Header="Sold By" Binding="{Binding SoldBy}" Width="100"/>
                                <DataGridTextColumn Header="Sold On" Binding="{Binding SoldAt, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <!-- New Serial Panel -->
                        <Border x:Name="NewSerialPanel" Grid.Row="3" BorderBrush="#0078D4" BorderThickness="2" 
                                Padding="20" Margin="0,15,0,0" Visibility="Collapsed" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Serial Number:" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="NewSerialBox" Height="32" Width="250"/>
                                    <TextBlock Text="Status:" FontWeight="Bold" VerticalAlignment="Center" Margin="30,0,10,0"/>
                                    <ComboBox x:Name="NewSerialStatusBox" Height="32" Width="150"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock x:Name="NewSerialCreatedBy" VerticalAlignment="Center" Foreground="Gray"/>
                                    <Button x:Name="SaveNewSerialButton" Content="Save Serial" Width="100" Height="32" 
                                            Click="SaveNewSerialButton_Click" Background="#28A745" Foreground="White" 
                                            BorderThickness="0" Cursor="Hand" Margin="20,0,10,0"/>
                                    <Button x:Name="CancelNewSerialButton" Content="Cancel" Width="80" Height="32" 
                                            Click="CancelNewSerialButton_Click" Background="#6C757D" Foreground="White" 
                                            BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Change Status Panel -->
                        <Border x:Name="ChangeStatusPanel" Grid.Row="3" BorderBrush="#28A745" BorderThickness="2" 
                                Padding="20" Margin="0,15,0,0" Visibility="Collapsed" Background="#E8F5E9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Selected Serial:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="SelectedSerialText" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock Text="New Status:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ChangeStatusComboBox" Height="32" Width="150" Margin="0,0,10,0"/>
                                <Button x:Name="UpdateStatusButton" Content="Update Status" Width="110" Height="32" 
                                        Click="UpdateStatusButton_Click" Background="#28A745" Foreground="White" 
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                                <Button x:Name="CancelStatusButton" Content="Cancel" Width="80" Height="32" 
                                        Click="CancelStatusButton_Click" Background="#6C757D" Foreground="White" 
                                        BorderThickness="0" Cursor="Hand" Margin="0,0,20,0"/>
                                <CheckBox x:Name="OnlinePickBox" Content="Online Pick" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
