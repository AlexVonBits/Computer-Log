<Window x:Class="Entertainment.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="User Profile" Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="25,20" CornerRadius="8,8,0,0">
            <TextBlock Text="USER PROFILE" FontSize="24" FontWeight="Bold" Foreground="White"/>
        </Border>
        
        <!-- Content -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1,0,1,1">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- User Info Section -->
                <GroupBox Grid.Row="0" Header="User Information" Margin="0,0,0,20">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" FontWeight="Bold"/>
                        <TextBlock x:Name="UsernameText" Grid.Row="0" Grid.Column="1" Text=""/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="NameText" Grid.Row="1" Grid.Column="1" Text="" Margin="0,10,0,0"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Initials:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="InitialsText" Grid.Row="2" Grid.Column="1" Text="" Margin="0,10,0,0"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Role:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="RoleText" Grid.Row="3" Grid.Column="1" Text="" Margin="0,10,0,0"/>
                    </Grid>
                </GroupBox>
                
                <!-- Change Password Section -->
                <GroupBox Grid.Row="1" Header="Change Password" Margin="0,0,0,20">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Password:" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="OldPasswordBox" Grid.Row="0" Grid.Column="1" Height="32" Width="250" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="New Password:" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="NewPasswordBox" Grid.Row="1" Grid.Column="1" Height="32" Width="250" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Confirm Password:" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="2" Grid.Column="1" Height="32" Width="250" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        
                        <Button x:Name="ChangePasswordButton" Grid.Row="3" Grid.Column="1" Content="Change Password" 
                                Click="ChangePasswordButton_Click" Width="150" Height="32" HorizontalAlignment="Left"
                                Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,10,0,0"/>
                        
                        <TextBlock x:Name="PasswordMessage" Grid.Row="4" Grid.Column="1" Text="" Foreground="Red" Margin="0,10,0,0"/>
                    </Grid>
                </GroupBox>
                
                <!-- User Management Section (only visible for TeamLead) -->
                <GroupBox x:Name="UserManagementSection" Grid.Row="2" Header="User Management" Visibility="Collapsed">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Add User Form -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Username:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="NewUsernameBox" Height="28"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Password:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <PasswordBox x:Name="NewUserPasswordBox" Height="28"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="First Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="NewFirstNameBox" Height="28"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Last Name:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox x:Name="NewLastNameBox" Height="28"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="4">
                                <CheckBox x:Name="NewUserAdminCheckBox" Content="Admin" Margin="0,20,0,0"/>
                                <Button x:Name="AddUserButton" Content="Add User" Click="AddUserButton_Click" 
                                        Width="80" Height="28" Margin="0,5,0,0" Background="#28A745" 
                                        Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Associates DataGrid -->
                        <DataGrid x:Name="AssociatesDataGrid" Grid.Row="2"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Height="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120"/>
                                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="120"/>
                                <DataGridTextColumn Header="Initials" Binding="{Binding Initials}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
                            <Button x:Name="DeleteUserButton" Content="Delete Selected User" Click="DeleteUserButton_Click" 
                                    Padding="15,8" Background="#DC3545" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0"/>
                            <Button x:Name="CreateTeamLeadButton" Content="Create New TeamLead" Click="CreateTeamLeadButton_Click" 
                                    Padding="15,8" Background="#FFC107" Foreground="Black" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</Window>
