<Window x:Class="Entertainment.TeamLeadSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Team Lead Setup" Height="600" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FFC107" Padding="25,20">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Text="TEAM LEAD SETUP" FontSize="24" FontWeight="Bold" Foreground="Black"/>
                <TextBlock x:Name="Title" Text="Create your Team Lead account" Foreground="Black" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Form -->
        <Border Grid.Row="1" Background="White" Margin="40">
            <StackPanel VerticalAlignment="Center" Width="400">
                <!-- Username -->
                <TextBlock x:Name="UserIdGuide" Text="USER ID" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="UserNameIdTeamLeadBox" Height="35" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>
                
                <!-- Password -->
                <TextBlock x:Name="PasswordGuide" Text="PASSWORD" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="PasswordTeamLeadBox" Height="35" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>
                
                <!-- First Name -->
                <TextBlock x:Name="Firstnameguide" Text="FIRST NAME" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="FirstNameTeamLeadBox" Height="35" Padding="10,8" FontSize="14" Margin="0,0,0,20"/>
                
                <!-- Last Name -->
                <TextBlock x:Name="Lastnameguide" Text="LAST NAME" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="LastNameTeamLeadBox" Height="35" Padding="10,8" FontSize="14" Margin="0,0,0,30"/>
                
                <!-- Submit Button -->
                <Button x:Name="TeamLeadSetupSubmit" Content="CREATE ACCOUNT" Height="40" 
                        FontSize="16" FontWeight="Bold" Background="#FFC107" Foreground="Black"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
