<Window x:Class="Entertainment.VerificationSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Inventory Verification Session" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,15" CornerRadius="8,8,0,0">
            <DockPanel>
                <Button x:Name="CancelButton" Content="Cancel Session" Click="CancelButton_Click" 
                        DockPanel.Dock="Right" Padding="15,8" Background="#DC3545" Foreground="White" 
                        BorderThickness="0" Cursor="Hand"/>
                <StackPanel>
                    <TextBlock x:Name="SessionTitleText" Text="Inventory Verification" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="ProgressText" Text="UPC 1 of 100" Foreground="White" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Main Content -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDD" BorderThickness="1,0,1,1">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left Panel: UPC Info -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <!-- UPC Display -->
                    <Border Background="#F8F9FA" Padding="20" CornerRadius="8" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="CURRENT UPC" FontWeight="Bold" Foreground="Gray" FontSize="12"/>
                            <TextBlock x:Name="UPCDisplayText" Text="012345678901" FontSize="28" FontWeight="Bold" Foreground="#0078D4" Margin="0,5,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MAKE" FontWeight="Bold" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="MakeText" Text="Samsung" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TYPE" FontWeight="Bold" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="TypeText" Text="Laptop" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <TextBlock Text="On Hand: " FontWeight="Bold" Foreground="Gray"/>
                                <TextBlock x:Name="OnHandCountText" Text="5" FontWeight="Bold" FontSize="18" Foreground="#28A745"/>
                            </StackPanel>
                            
                            <TextBlock x:Name="CrossRefText" Text="" Foreground="#6C757D" FontStyle="Italic" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Barcode Display -->
                    <Border Background="White" Padding="15" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Image x:Name="BarcodeImage" Width="300" Height="100" Stretch="Uniform"/>
                            <TextBlock x:Name="BarcodeLabelText" Text="" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="14" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Previous Notes -->
                    <TextBlock Text="PREVIOUS VERIFICATION NOTES" FontWeight="Bold" Foreground="Gray" FontSize="12" Margin="0,20,0,10"/>
                    <TextBox x:Name="PreviousNotesTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" 
                             Height="120" VerticalScrollBarVisibility="Auto" Background="#F8F9FA" BorderBrush="#DDD"/>
                    
                    <!-- UPC Notes -->
                    <TextBlock Text="CURRENT VERIFICATION NOTES" FontWeight="Bold" Foreground="Gray" FontSize="12" Margin="0,15,0,10"/>
                    <TextBox x:Name="UPCNotesTextBox" TextWrapping="Wrap" AcceptsReturn="True" 
                             Height="80" VerticalScrollBarVisibility="Auto" BorderBrush="#0078D4"/>
                </StackPanel>
                
                <!-- Right Panel: Serial Numbers -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="SERIAL NUMBERS" FontWeight="Bold" Foreground="Gray" FontSize="14" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SerialNumbersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,0,10" CornerRadius="4" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding SerialNumber}" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding Status}" Foreground="#6C757D" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="150" Tag="{Binding Id}"
                                                      ItemsSource="{Binding DataContext.SerialStatuses, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Status, Mode=TwoWay}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <EventSetter Event="SelectionChanged" Handler="SerialStatusComboBox_SelectionChanged"/>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <TextBlock x:Name="NoSerialsMessage" Grid.Row="1" Text="No serial numbers found for this UPC." 
                               Foreground="Gray" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    
                    <!-- Verification Status -->
                    <Border Grid.Row="2" Background="#F8F9FA" Padding="20" CornerRadius="8" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="VERIFICATION STATUS" FontWeight="Bold" Foreground="Gray" FontSize="14" Margin="0,0,0,15"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NoIssuesRadio" Content="No Issues" GroupName="VerificationStatus" 
                                             Margin="0,0,30,0" FontSize="14"/>
                                <RadioButton x:Name="IssueFixedRadio" Content="Issue Found - Fixed" GroupName="VerificationStatus" 
                                             Margin="0,0,30,0" FontSize="14"/>
                                <RadioButton x:Name="IssueNotFixedRadio" Content="Issue Not Fixed" GroupName="VerificationStatus" 
                                             FontSize="14"/>
                            </StackPanel>
                            
                            <!-- Reason Panel (shown when Issue Not Fixed is selected) -->
                            <Border x:Name="ReasonPanel" Visibility="Collapsed" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="Reason (required):" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ReasonTextBox" TextWrapping="Wrap" AcceptsReturn="True" 
                                             Height="80" VerticalScrollBarVisibility="Auto" BorderBrush="#DC3545"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Navigation Buttons -->
        <Border Grid.Row="2" Background="#F8F9FA" Padding="20" CornerRadius="0,0,8,8">
            <DockPanel>
                <Button x:Name="PreviousButton" Content="Previous" Click="PreviousButton_Click" 
                        Padding="30,12" Background="#6C757D" Foreground="White" 
                        BorderThickness="0" Cursor="Hand" IsEnabled="False"/>
                <Button x:Name="NextButton" Content="Next" Click="NextButton_Click" 
                        Padding="30,12" Background="#28A745" Foreground="White" 
                        BorderThickness="0" Cursor="Hand" DockPanel.Dock="Right" IsEnabled="False"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
