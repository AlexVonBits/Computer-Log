<Window x:Class="Entertainment.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Entertainment"
        mc:Ignorable="d"
        Title="LoginPage" Height="450" Width="800"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Logo - centered in upper area -->
        <Image Grid.Row="0" Grid.Column="1" 
               Source="/Images/Walmart-Logo-2008-present.jpg" 
               Stretch="Uniform" 
               MaxHeight="150" 
               Margin="0,30,0,20"
               VerticalAlignment="Center"/>
        
        <!-- Username row -->
        <TextBlock x:Name="UserID" Grid.Row="1" Grid.Column="1" 
                   TextWrapping="Wrap" Text="User Name:" 
                   HorizontalAlignment="Right" Margin="0,0,10,5"
                   VerticalAlignment="Center"/>
        <TextBox x:Name="UsernameBox" Grid.Row="1" Grid.Column="2" 
                 TextWrapping="Wrap" Width="200" 
                 HorizontalAlignment="Left" Margin="0,0,0,5"/>
        
        <!-- Password row -->
        <TextBlock x:Name="PasswordText" Grid.Row="2" Grid.Column="1" 
                   TextWrapping="Wrap" Text="Password:" 
                   HorizontalAlignment="Right" Margin="0,0,10,20"
                   VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="2" 
                     Width="200" 
                     HorizontalAlignment="Left" Margin="0,0,0,20"/>
        
        <!-- Sign In button -->
        <Button x:Name="SignIn" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                Content="Sign In" Width="120" Height="35"
                HorizontalAlignment="Center" Margin="0,0,0,30"/>
    </Grid>
</Window>
