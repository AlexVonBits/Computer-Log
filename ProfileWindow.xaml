<Window x:Class="Entertainment.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Entertainment"
        mc:Ignorable="d"
        Title="Profile" Height="550" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Back and Sign Out -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" 
                    DockPanel.Dock="Left" Padding="10,5" Margin="0,0,10,0"/>
            <Button x:Name="SignOutButton" Content="Sign Out" Click="SignOut_Click" 
                    DockPanel.Dock="Right" Padding="10,5"/>
        </DockPanel>

        <!-- User Info Section -->
        <GroupBox Grid.Row="1" Header="User Information" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Username: " FontWeight="Bold" Width="100"/>
                    <TextBlock x:Name="UsernameText" Text=""/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Name: " FontWeight="Bold" Width="100"/>
                    <TextBlock x:Name="NameText" Text=""/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Initials: " FontWeight="Bold" Width="100"/>
                    <TextBlock x:Name="InitialsText" Text=""/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Role: " FontWeight="Bold" Width="100"/>
                    <TextBlock x:Name="RoleText" Text=""/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Password Change Section -->
        <GroupBox Grid.Row="2" Header="Change Password" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <TextBlock Text="Old Password:" Margin="0,0,0,3"/>
                <PasswordBox x:Name="OldPasswordBox" Margin="0,0,0,10"/>

                <TextBlock Text="New Password:" Margin="0,0,0,3"/>
                <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,10"/>

                <TextBlock Text="Confirm Password:" Margin="0,0,0,3"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,10"/>

                <Button x:Name="ChangePasswordButton" Content="Change Password" 
                        Width="150" HorizontalAlignment="Left" Click="ChangePasswordButton_Click"/>
                <TextBlock x:Name="PasswordMessage" Foreground="Red" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- User Management Section (TeamLead Only) -->
        <GroupBox x:Name="UserManagementSection" Grid.Row="3" Header="User Management" Margin="0,0,0,15" Visibility="Collapsed">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Add New User Form -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Username"/>
                        <TextBox x:Name="NewUsernameBox" Width="100"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Password"/>
                        <PasswordBox x:Name="NewUserPasswordBox" Width="100"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="First Name"/>
                        <TextBox x:Name="NewFirstNameBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Last Name"/>
                        <TextBox x:Name="NewLastNameBox" Width="80"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Bottom">
                        <CheckBox x:Name="NewUserAdminCheckBox" Content="Admin"/>
                    </StackPanel>
                    <Button x:Name="AddUserButton" Content="Add User" VerticalAlignment="Bottom" Click="AddUserButton_Click"/>
                </StackPanel>

                <!-- Delete User Button -->
                <Button x:Name="DeleteUserButton" Grid.Row="1" Content="Delete Selected User" 
                        HorizontalAlignment="Left" Margin="0,0,0,10" Click="DeleteUserButton_Click"/>

                <!-- Associates DataGrid -->
                <DataGrid x:Name="AssociatesDataGrid" Grid.Row="2" AutoGenerateColumns="False" 
                          CanUserAddRows="False" CanUserDeleteRows="False" Height="150">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Initials" Binding="{Binding Initials}" Width="60" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Create New TeamLead Button (TeamLead Only) -->
        <Button x:Name="CreateTeamLeadButton" Grid.Row="4" Content="Create New TeamLead" 
                Visibility="Collapsed" Click="CreateTeamLeadButton_Click" Margin="0,0,0,15" Width="150" HorizontalAlignment="Left"/>

        <!-- Close Button -->
        <Button Grid.Row="7" Content="Close" Width="100" HorizontalAlignment="Right" Click="CloseButton_Click"/>
    </Grid>
</Window>
