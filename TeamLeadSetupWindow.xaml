<Window x:Class="Entertainment.TeamLeadSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Entertainment"
        mc:Ignorable="d"
        Title="TeamLeadSetupWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Profile and Sign Out -->
        <DockPanel Grid.Row="0" Margin="10">
            <Button x:Name="ProfileButton" Content="Profile" Click="ProfileButton_Click" 
                    DockPanel.Dock="Left" Padding="10,5" Margin="0,0,10,0"/>
            <Button x:Name="SignOutButton" Content="Sign Out" Click="SignOut_Click" 
                    DockPanel.Dock="Right" Padding="10,5"/>
        </DockPanel>
        
        <!-- Main Content -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Vertical" VerticalAlignment="Center" Height="297">
            <TextBlock x:Name="Title" TextWrapping="Wrap" Text="New Team Lead Setup" FontSize="24"/>
            <TextBlock x:Name="UserIdGuide" TextWrapping="Wrap" Text="Walmart User ID:"/>
            <TextBox x:Name="UserNameIdTeamLeadBox" TextWrapping="Wrap" Width="120"/>
            <TextBlock x:Name="PasswordGuide" TextWrapping="Wrap" Text="Walmart Password:"/>
            <TextBox x:Name="PasswordTeamLeadBox" TextWrapping="Wrap" Width="120"/>
            <TextBlock x:Name="Firstnameguide" TextWrapping="Wrap" Text="First Name:"/>
            <TextBox x:Name="FirstNameTeamLeadBox" TextWrapping="Wrap" Width="120"/>
            <TextBlock x:Name="Lastnameguide" TextWrapping="Wrap" Text="Last Name:"/>
            <TextBox x:Name="LastNameTeamLeadBox" TextWrapping="Wrap" Width="120"/>
            <Button x:Name="TeamLeadSetupSubmit" Content="Submit" Width="148" Height="43" Click="TeamLeadSetupSubmit_Click" Margin="0,10,0,0"/>
        </StackPanel>

    </Grid>
</Window>
